# Copy to ".env" and adjust before running "docker compose up" (or for local dev,
# see README.md). Compare with .env.template, which is Medusa's own stock version
# of this file - this one adds the production/docker-compose-oriented variables.

# Two DIFFERENT networks, usually - don't assume they're the same. Same values as in
# goa_webapp_shop's .env - see its .env.example for the discovery commands.
PROXY_NETWORK_NAME=fotosvorju-proxy
DB_NETWORK_NAME=life_webapp_default

# This project's own Postgres database (products, variants, prices, inventory, orders,
# customers - everything commerce-related). Create it once on the shared Postgres
# container before first start, e.g.:
#   docker exec -it <postgres-container> psql -U goa -c \
#     "CREATE USER life_webapp_shop_admin WITH PASSWORD 'change-me'; CREATE DATABASE life_webapp_shop_admin OWNER life_webapp_shop_admin;"
# MEDUSA_DB_HOST is the Postgres container's own name (from `docker ps`), not a Compose
# service alias - this app isn't part of that other project's compose file. DB name/user
# follow the same life_webapp_shop_admin naming as the deployment directory and containers.
MEDUSA_DB_HOST=life_webapp-db-1
MEDUSA_DB_NAME=life_webapp_shop_admin
MEDUSA_DB_USER=life_webapp_shop_admin
MEDUSA_DB_PASSWORD=change-me

# Random long strings in production - e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# CORS allow-lists. STORE_CORS is only relevant if something in the browser (not
# goa_webapp_shop's server-side calls) ever talks to this API directly - e.g. a future
# Stripe Elements integration confirming payment client-side.
STORE_CORS=https://shop.heimfeld.life
ADMIN_CORS=https://shop-admin.heimfeld.life
AUTH_CORS=https://shop-admin.heimfeld.life

# Public URL this backend is reachable at. Required - without it, uploaded product image
# URLs default to "http://localhost:9000/static/...", which never resolves for an actual
# browser (not even in the Admin Dashboard's own media preview).
MEDUSA_BACKEND_URL=https://shop-admin.heimfeld.life

# From the Stripe Dashboard (use the TEST keys while trying this out, LIVE keys only once
# you're ready to take real payments - https://dashboard.stripe.com/apikeys).
STRIPE_API_KEY=sk_test_...
# Create a webhook endpoint in the Stripe Dashboard pointing at
# https://shop-admin.heimfeld.life/hooks/payment/stripe_stripe (see README for which events
# to select), then paste its signing secret here.
STRIPE_WEBHOOK_SECRET=whsec_...

MEDUSA_PORT=9000
